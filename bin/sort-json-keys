#!/usr/bin/env bash

set -euo pipefail

usage() {
  echo "Usage: sort-json-keys [-r] <file>" >&2
  exit 1
}

RECURSIVE=""

while getopts ":r" OPT; do
  case "$OPT" in
    r) RECURSIVE=1 ;;
    *) usage ;;
  esac
done

shift $((OPTIND - 1))

[ $# -eq 1 ] || usage

SORTED=$(jq ${RECURSIVE:+--sort-keys} 'to_entries | sort_by(.key) | from_entries' "$1")
printf '%s\n' "$SORTED" > "$1"
